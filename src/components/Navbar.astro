---
import Icon from './Icon.astro';
import { playStoreUrl } from '../data/play-store';
import { sourceRepoUrl } from '../data/site';

const baseUrl = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const isActive = (suffix: string) => {
  const cleanPath = path.replace(baseUrl, '/');
  if (suffix === '') return cleanPath === '/' || cleanPath === '';
  return cleanPath === `/${suffix}` || cleanPath.startsWith(`/${suffix}/`);
};

const links = [
  { suffix: '', es: 'Inicio', en: 'Home' },
  { suffix: 'features', es: 'Funciones', en: 'Features' },
  { suffix: 'faq', es: 'Preguntas', en: 'FAQ' },
  { suffix: 'privacy', es: 'Privacidad', en: 'Privacy' },
];
---

<header
  class="fixed left-0 right-0 top-3 z-50 sm:top-4"
  x-data="navbarComponent()"
  x-init="init()"
>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[999] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-paper">
    <span x-cloak x-show="lang==='es'">Saltar al contenido</span><span x-cloak x-show="lang==='en'">Skip to content</span>
  </a>

  <div class="container-editorial">
    <div
      class="relative grid grid-cols-[1fr_auto] items-center gap-3 rounded-full border bg-paper/80 py-2 pl-2.5 pr-2 backdrop-blur-xl backdrop-saturate-150 transition-all duration-300 sm:gap-6 md:grid-cols-[1fr_auto_1fr]"
      :class="scrolled ? 'border-ink/15 shadow-[0_10px_30px_-12px_rgba(10,10,14,0.25)]' : 'border-ink/10'"
    >
      <a
        href={baseUrl}
        class="flex items-center gap-2.5 rounded-full pr-2"
        aria-label="Inicio de Fun Phone" :aria-label="lang === 'es' ? 'Inicio de Fun Phone' : 'Fun Phone home'"
      >
        <img src={baseUrl + 'assets/logo-96.png'} width="36" height="36" alt="" class="h-9 w-9 rounded-xl border border-ink/10 bg-white p-1" />
        <span class="font-display text-[1rem] font-extrabold tracking-tight text-ink">Fun Phone</span>
      </a>

      <nav class="hidden items-center gap-1 md:flex" aria-label="Principal" :aria-label="lang === 'es' ? 'Principal' : 'Main'">
        {links.map((link) => (
          <a
            href={baseUrl + (link.suffix ? `${link.suffix}/` : '')}
            aria-current={isActive(link.suffix) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-2 text-[0.85rem] font-semibold transition-colors',
              isActive(link.suffix) ? 'bg-ink text-paper' : 'text-ink-muted hover:bg-ink/5 hover:text-ink',
            ]}
          >
            <span x-cloak x-show="lang==='es'">{link.es}</span>
            <span x-cloak x-show="lang==='en'">{link.en}</span>
          </a>
        ))}
      </nav>

      <div class="col-start-2 flex items-center justify-end gap-1 md:col-start-3">
        <a
          href={sourceRepoUrl}
          target="_blank"
          rel="noopener"
          class="hidden h-10 w-10 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-ink/5 hover:text-ink sm:flex"
          aria-label="Código fuente en GitHub" :aria-label="lang === 'es' ? 'Código fuente en GitHub' : 'Source code on GitHub'"
        >
          <Icon name="github" class="h-[1.15rem] w-[1.15rem]" />
        </a>

        <button
          type="button"
          x-on:click="toggleLanguage()"
          class="hidden h-10 items-center rounded-full px-3 font-mono text-[0.72rem] font-bold tracking-wider text-ink-muted transition-colors hover:bg-ink/5 hover:text-ink sm:flex"
          aria-label="Cambiar idioma" :aria-label="lang === 'es' ? 'Switch to English' : 'Cambiar a español'"
        >
          <span x-cloak x-text="lang === 'es' ? 'EN' : 'ES'">EN</span>
        </button>

        <button
          type="button"
          x-on:click="toggleTheme()"
          class="flex h-10 w-10 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-ink/5 hover:text-ink"
          aria-label="Cambiar tema" :aria-label="isDark ? (lang === 'es' ? 'Modo claro' : 'Light mode') : (lang === 'es' ? 'Modo oscuro' : 'Dark mode')"
        >
          <svg x-cloak x-show="!isDark" class="h-[1.1rem] w-[1.1rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
          <svg x-cloak x-show="isDark" class="h-[1.1rem] w-[1.1rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41"/></svg>
        </button>

        <a
          href={playStoreUrl('navbar_desktop')}
          target="_blank"
          rel="noopener"
          class="ml-1 hidden h-10 items-center gap-2 rounded-full bg-ink px-4 text-[0.85rem] font-bold text-paper transition-colors hover:bg-flame sm:flex"
        >
          <Icon name="play" class="h-4 w-4" />
          <span x-cloak x-show="lang==='es'">Instalar</span>
          <span x-cloak x-show="lang==='en'">Install</span>
        </a>

        <button
          type="button"
          x-on:click="toggleMenu()"
          class="flex h-10 w-10 items-center justify-center rounded-full text-ink transition-colors hover:bg-ink/5 md:hidden"
          :aria-expanded="menuOpen.toString()"
          aria-controls="mobile-menu"
          aria-label="Menú" :aria-label="lang === 'es' ? 'Menú' : 'Menu'"
        >
          <svg x-show="!menuOpen" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg x-cloak x-show="menuOpen" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M6 18L18 6"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    x-cloak x-show="menuOpen"
    x-transition.opacity.duration.200ms
    class="fixed inset-0 z-40 md:hidden"
    @keydown.escape.window="menuOpen && closeMenu()"
  >
    <div class="absolute inset-0 bg-ink/20 backdrop-blur-sm" @click="closeMenu()"></div>
    <div
      class="absolute left-1/2 top-[4.75rem] max-h-[calc(100dvh-6rem)] w-[min(420px,calc(100vw-1.5rem))] -translate-x-1/2 overflow-y-auto rounded-3xl border border-ink/10 bg-paper p-3 shadow-2xl"
      @click.stop
    >
      <nav class="flex flex-col" :aria-label="lang === 'es' ? 'Principal' : 'Main'">
        {links.map((link) => (
          <a
            href={baseUrl + (link.suffix ? `${link.suffix}/` : '')}
            x-on:click="closeMenu()"
            aria-current={isActive(link.suffix) ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between rounded-2xl px-4 py-3.5 text-base font-bold transition-colors',
              isActive(link.suffix) ? 'bg-ink/5 text-ink' : 'text-ink hover:bg-ink/5',
            ]}
          >
            <span><span x-cloak x-show="lang==='es'">{link.es}</span><span x-cloak x-show="lang==='en'">{link.en}</span></span>
            {isActive(link.suffix) && <span class="h-2 w-2 rounded-full bg-flame"></span>}
          </a>
        ))}
        <a href={sourceRepoUrl} target="_blank" rel="noopener" class="flex items-center justify-between rounded-2xl px-4 py-3.5 text-base font-bold text-ink hover:bg-ink/5">
          <span><span x-cloak x-show="lang==='es'">Código fuente</span><span x-cloak x-show="lang==='en'">Source code</span></span>
          <Icon name="github" class="h-5 w-5 text-ink-muted" />
        </a>
      </nav>
      <div class="mt-2 grid grid-cols-2 gap-2 border-t border-ink/10 pt-3">
        <button type="button" x-on:click="toggleLanguage()" class="rounded-2xl border border-ink/10 py-3 text-sm font-semibold text-ink">
          <span x-cloak x-text="lang === 'es' ? 'English' : 'Español'">English</span>
        </button>
        <button type="button" x-on:click="toggleTheme()" class="rounded-2xl border border-ink/10 py-3 text-sm font-semibold text-ink">
          <span x-cloak x-text="isDark ? (lang==='es' ? 'Tema claro' : 'Light theme') : (lang==='es' ? 'Tema oscuro' : 'Dark theme')"></span>
        </button>
      </div>
      <a href={playStoreUrl('navbar_mobile')} target="_blank" rel="noopener" x-on:click="closeMenu()" class="mt-2 flex items-center justify-center gap-2 rounded-2xl bg-ink py-3.5 text-sm font-bold text-paper hover:bg-flame">
        <Icon name="play" class="h-4 w-4" />
        <span x-cloak x-show="lang==='es'">Instalar desde Google Play</span><span x-cloak x-show="lang==='en'">Install from Google Play</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  function navbarComponent() {
    return {
      menuOpen: false,
      lang: document.documentElement.dataset.lang || 'es',
      isDark: (() => {
        const s = window.funPhonePreferences.read('darkMode');
        if (s !== null) return s === 'true';
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      })(),
      scrolled: false,
      init() {
        this.scrolled = window.scrollY > 24;
        this.applyTheme();
        document.documentElement.setAttribute('data-lang', this.lang);
        document.documentElement.lang = this.lang;
        window.addEventListener('scroll', () => {
          this.scrolled = window.scrollY > 24;
        }, { passive: true });
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (window.funPhonePreferences.read('darkMode') === null) {
            this.isDark = e.matches;
            this.applyTheme();
          }
        });
        window.addEventListener('lang', (e) => {
          if (e.detail && e.detail !== this.lang) {
            this.lang = e.detail;
            this.applyLang();
          }
        });
      },
      toggleMenu() {
        this.menuOpen = !this.menuOpen;
        document.body.classList.toggle('overflow-hidden', this.menuOpen);
      },
      closeMenu() {
        this.menuOpen = false;
        document.body.classList.remove('overflow-hidden');
      },
      toggleLanguage() {
        this.lang = this.lang === 'es' ? 'en' : 'es';
        this.applyLang();
      },
      applyLang() {
        window.funPhonePreferences.write('lang', this.lang);
        document.documentElement.setAttribute('data-lang', this.lang);
        document.documentElement.lang = this.lang;
        window.dispatchEvent(new CustomEvent('lang', { detail: this.lang }));
      },
      toggleTheme() {
        this.isDark = !this.isDark;
        window.funPhonePreferences.write('darkMode', String(this.isDark));
        this.applyTheme();
      },
      applyTheme() {
        document.documentElement.classList.toggle('dark', this.isDark);
        document.documentElement.style.colorScheme = this.isDark ? 'dark' : 'light';
      }
    };
  }
</script>
