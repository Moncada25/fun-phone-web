---
import Icon from './Icon.astro';
import { playStoreUrl } from '../data/play-store';
import {
  discussionsUrl,
  issuesUrl,
  latestReleaseUrl,
  licenseUrl,
  obtainiumUrl,
  productFacts,
  sourceRepoUrl,
  supportEmail,
} from '../data/site';

const baseUrl = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

interface FooterItem {
  es: string;
  en: string;
  href: string | null;
  external?: boolean;
  mono?: boolean;
}

interface FooterSection {
  title: { es: string; en: string };
  items: FooterItem[];
}

const sections: FooterSection[] = [
  {
    title: { es: 'Producto', en: 'Product' },
    items: [
      { es: 'Funciones', en: 'Features', href: baseUrl + 'features/' },
      { es: 'Preguntas frecuentes', en: 'FAQ', href: baseUrl + 'faq/' },
      { es: 'Privacidad', en: 'Privacy', href: baseUrl + 'privacy/' },
    ],
  },
  {
    title: { es: 'Descargar', en: 'Download' },
    items: [
      { es: 'Google Play', en: 'Google Play', href: playStoreUrl('footer_link'), external: true },
      { es: 'APK en GitHub', en: 'APK on GitHub', href: latestReleaseUrl, external: true },
      { es: 'Obtainium', en: 'Obtainium', href: obtainiumUrl, external: true },
    ],
  },
  {
    title: { es: 'Código abierto', en: 'Open source' },
    items: [
      { es: 'Código fuente', en: 'Source code', href: sourceRepoUrl, external: true },
      { es: 'Reportar un error', en: 'Report a bug', href: issuesUrl, external: true },
      { es: 'Discusiones', en: 'Discussions', href: discussionsUrl, external: true },
      { es: `Licencia ${productFacts.license}`, en: `${productFacts.license} license`, href: licenseUrl, external: true },
    ],
  },
  {
    title: { es: 'Contacto', en: 'Contact' },
    items: [
      { es: supportEmail, en: supportEmail, href: `mailto:${supportEmail}`, mono: true },
      { es: 'Medellín, Colombia', en: 'Medellín, Colombia', href: null },
    ],
  },
];
---

<footer class="relative mt-20 border-t border-ink/10 bg-surface/60">
  <div class="container-editorial py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_2fr]">
      <div>
        <a href={baseUrl} class="inline-flex items-center gap-3">
          <img src={baseUrl + 'assets/logo-96.png'} width="44" height="44" alt="" class="h-11 w-11 rounded-2xl border border-ink/10 bg-white p-1.5" loading="lazy" />
          <span class="font-display text-xl font-extrabold tracking-tight text-ink">Fun Phone</span>
        </a>
        <p class="mt-5 max-w-sm text-pretty text-sm leading-relaxed text-ink-muted">
          <span x-cloak x-show="lang==='es'">Marcador y contactos privados para Android, con herramientas opcionales. Sin anuncios, sin analítica y de código abierto.</span>
          <span x-cloak x-show="lang==='en'">A private dialer and contacts app for Android, with optional tools. No ads, no analytics, and open source.</span>
        </p>
        <a href={playStoreUrl('footer_cta')} target="_blank" rel="noopener" class="btn-store mt-7">
          <Icon name="play" class="h-5 w-5 shrink-0" />
          <span class="flex flex-col text-left">
            <span class="text-[0.65rem] font-medium opacity-80">
              <span x-cloak x-show="lang==='es'">Disponible en</span>
              <span x-cloak x-show="lang==='en'">Get it on</span>
            </span>
            <span class="text-base font-bold tracking-tight">Google Play</span>
          </span>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-10 md:grid-cols-[1fr_1fr_1fr_1.5fr]">
        {sections.map((col, i) => (
          <div class:list={[i === sections.length - 1 && 'col-span-2 md:col-span-1']}>
            <h2 class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.16em] text-ink-ghost">
              <span x-cloak x-show={`lang==='es'`}>{col.title.es}</span>
              <span x-cloak x-show={`lang==='en'`}>{col.title.en}</span>
            </h2>
            <ul class="mt-5 space-y-3">
              {col.items.map((item) => (
                <li>
                  {item.href ? (
                    <a
                      href={item.href}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener' : undefined}
                      class:list={[
                        'group inline-flex items-center gap-1.5 [overflow-wrap:anywhere] transition-colors hover:text-flame',
                        item.mono ? 'font-mono text-xs text-ink-muted' : 'text-sm font-semibold text-ink',
                      ]}
                    >
                      <span x-cloak x-show={`lang==='es'`}>{item.es}</span>
                      <span x-cloak x-show={`lang==='en'`}>{item.en}</span>
                      {item.external && <Icon name="external" class="h-3 w-3 shrink-0 opacity-50" strokeWidth={2} />}
                    </a>
                  ) : (
                    <span class="text-sm text-ink-muted">
                      <span x-cloak x-show={`lang==='es'`}>{item.es}</span>
                      <span x-cloak x-show={`lang==='en'`}>{item.en}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-ink/10 pt-8 text-xs text-ink-ghost md:flex-row md:items-center md:justify-between">
      <p>© {year} Bookverse · Fun Phone</p>
      <p>
        <span x-cloak x-show="lang==='es'">App bajo licencia {productFacts.license}. Google Play es una marca de Google LLC.</span>
        <span x-cloak x-show="lang==='en'">App licensed under {productFacts.license}. Google Play is a trademark of Google LLC.</span>
      </p>
    </div>
  </div>
</footer>
