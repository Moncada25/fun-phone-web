---
import Icon from './Icon.astro';
import { playStoreUrl } from '../data/play-store';
import { latestReleaseUrl } from '../data/site';

export interface Props {
  /** utm_content value for the Play install referrer. */
  content: string;
  inverted?: boolean;
  class?: string;
}

const { content, inverted = false, class: className = '' } = Astro.props;
---

<div class:list={['flex flex-wrap items-center gap-3', className]}>
  <a
    href={playStoreUrl(content)}
    target="_blank"
    rel="noopener"
    class:list={['btn-store', inverted && 'border-paper bg-paper text-ink hover:border-flame hover:bg-flame hover:text-paper']}
  >
    <Icon name="play" class="h-6 w-6 shrink-0" />
    <span class="flex flex-col text-left">
      <span class="text-[0.68rem] font-medium opacity-80">
        <span x-cloak x-show="lang==='es'">Disponible en</span>
        <span x-cloak x-show="lang==='en'">Get it on</span>
      </span>
      <span class="text-[1.05rem] font-bold tracking-tight">Google Play</span>
    </span>
  </a>
  <a
    href={latestReleaseUrl}
    target="_blank"
    rel="noopener"
    class:list={['btn-outline', inverted && 'border-paper/30 text-paper hover:border-paper hover:bg-paper/10']}
  >
    <Icon name="github" class="h-6 w-6 shrink-0" />
    <span class="flex flex-col text-left">
      <span class="text-[0.68rem] font-medium opacity-80">
        <span x-cloak x-show="lang==='es'">APK sin Google</span>
        <span x-cloak x-show="lang==='en'">Google-free APK</span>
      </span>
      <span class="text-[1.05rem] font-bold tracking-tight">GitHub</span>
    </span>
  </a>
</div>
