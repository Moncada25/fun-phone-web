---
import Icon from './Icon.astro';
import { playStoreUrl } from '../data/play-store';
---

<div
  class="fixed inset-x-3 bottom-3 z-40 md:hidden"
  x-data="{ visible: false, dismissed: false }"
  x-init="window.addEventListener('scroll', () => { visible = window.scrollY > 640 }, { passive: true })"
  x-cloak
  x-show="visible && !dismissed"
  x-transition:enter="transition duration-300 ease-out"
  x-transition:enter-start="translate-y-4 opacity-0"
  x-transition:enter-end="translate-y-0 opacity-100"
>
  <div class="flex items-center gap-2 rounded-2xl border border-ink/10 bg-paper/90 p-2 shadow-[0_16px_40px_-12px_rgba(10,10,14,0.35)] backdrop-blur-xl">
    <img src={import.meta.env.BASE_URL + 'assets/logo-96.png'} width="40" height="40" alt="" class="h-10 w-10 rounded-xl border border-ink/10 bg-white p-1" loading="lazy" />
    <div class="min-w-0 flex-1 leading-tight">
      <p class="truncate text-sm font-bold text-ink">Fun Phone</p>
      <p class="truncate text-xs text-ink-muted">
        <span x-cloak x-show="lang==='es'">Gratis · Sin anuncios</span>
        <span x-cloak x-show="lang==='en'">Free · No ads</span>
      </p>
    </div>
    <a
      href={playStoreUrl('sticky_mobile')}
      target="_blank"
      rel="noopener"
      class="inline-flex h-11 items-center gap-2 rounded-xl bg-ink px-4 text-sm font-bold text-paper"
    >
      <Icon name="play" class="h-4 w-4" />
      <span x-cloak x-show="lang==='es'">Instalar</span>
      <span x-cloak x-show="lang==='en'">Install</span>
    </a>
    <button
      type="button"
      x-on:click="dismissed = true"
      class="flex h-11 w-11 items-center justify-center rounded-xl text-ink-muted"
      aria-label="Cerrar" :aria-label="lang === 'es' ? 'Cerrar' : 'Close'"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M6 18L18 6"/></svg>
    </button>
  </div>
</div>
