---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import InstallButtons from '../../components/InstallButtons.astro';
import LocalizedImage from '../../components/LocalizedImage.astro';
import { coreFeatures, customization, gameNames, toolFeatures } from '../../data/features';
import { productFacts } from '../../data/site';

const base = import.meta.env.BASE_URL;

type Bullets = { es: string[]; en: string[] };

const coreDetails: Record<string, Bullets> = {
  dialer: {
    es: ['Búsqueda T9 en nombres y números', 'Bandera y prefijo del país mientras marcas', 'Si un solo contacto coincide, aparece listo para llamar', 'Dual-SIM según el dispositivo y el operador'],
    en: ['T9 search across names and numbers', 'Country flag and code as you dial', 'When a single contact matches, it is ready to call', 'Dual SIM depending on device and carrier'],
  },
  contacts: {
    es: ['Favoritos y widget para la pantalla de inicio', 'Cuentas de Google o del dispositivo, gestionadas por Android', 'Importa y exporta vCard o JSON', 'Encuentra y combina duplicados', 'Comparte contactos por QR o como archivo'],
    en: ['Favorites and a home-screen widget', 'Google or device accounts, managed by Android', 'vCard and JSON import and export', 'Find and merge duplicates', 'Share contacts by QR or as a file'],
  },
  calls: {
    es: ['Contesta, rechaza o responde con un mensaje', 'Retener, silenciar, altavoz, teclado y Bluetooth', 'Recientes, perdidas y búsqueda en el historial', 'Filtro de spam con el filtrado de llamadas de Android', 'Estado del dispositivo para revisar permisos y el rol de marcador'],
    en: ['Answer, decline or reply with a message', 'Hold, mute, speaker, keypad and Bluetooth', 'Recents, missed calls and history search', 'Spam filter built on Android call screening', 'Device Status to review permissions and the dialer role'],
  },
};

const toolDetails: Record<string, Bullets> = {
  notes: {
    es: ['Texto enriquecido y checklists', 'Recordatorios con alarma', 'Notas de audio', 'Bloqueo con PIN o biometría'],
    en: ['Rich text and checklists', 'Reminders with alarms', 'Audio notes', 'PIN or biometric lock'],
  },
  vault: {
    es: ['Cifrado local con Android Keystore', 'Desbloqueo con PIN o biometría', 'Generador de contraseñas', 'Códigos de verificación en dos pasos', 'Servicio de autocompletado de Android'],
    en: ['Local encryption with Android Keystore', 'Unlock with PIN or biometrics', 'Password generator', 'Two-step verification codes', 'Android autofill service'],
  },
  expenses: {
    es: ['Gastos fijos y variables', 'Categorías y presupuestos', 'Estadísticas en el dispositivo', 'Importación y exportación'],
    en: ['Fixed and variable expenses', 'Categories and budgets', 'On-device statistics', 'Import and export'],
  },
  qr: {
    es: ['Escáner con zoom, enfoque y linterna', 'Lectura desde la galería', 'Generador de códigos', 'Contactos en QR'],
    en: ['Scanner with zoom, focus and flashlight', 'Read codes from your gallery', 'Code generator', 'Contacts as QR codes'],
  },
  voice: {
    es: ['Dictado de voz a texto', 'Lectura en voz alta con selector de voz', 'Usa el proveedor de voz de Android'],
    en: ['Speech-to-text dictation', 'Text-to-speech with a voice picker', 'Uses your Android speech provider'],
  },
  calendar: {
    es: ['Cumpleaños de tus contactos', 'Eventos de los calendarios de Android', 'Festivos públicos opcionales (Nager.Date)'],
    en: ['Your contacts’ birthdays', 'Events from your Android calendars', 'Optional public holidays (Nager.Date)'],
  },
  pomodoro: {
    es: ['Ciclos 25/5 configurables', 'Sonidos y notificaciones', 'Sigue en segundo plano'],
    en: ['Configurable 25/5 cycles', 'Sounds and notifications', 'Keeps running in the background'],
  },
  wellbeing: {
    es: ['Calendario de ciclo con predicciones', 'Fases del ciclo', 'Datos solo en tu dispositivo'],
    en: ['Cycle calendar with predictions', 'Cycle phases', 'Data stays on your device'],
  },
  paint: {
    es: ['Lápiz, borrador, desenfoque, texto y formas', 'Importa imágenes', 'Exporta y comparte'],
    en: ['Pencil, eraser, blur, text and shapes', 'Import images', 'Export and share'],
  },
  games: {
    es: [gameNames.es, 'Estadísticas y récords por juego', 'Sin micropagos'],
    en: [gameNames.en, 'Stats and records for each game', 'No in-app purchases'],
  },
};

const extras = [
  { icon: 'globe' as const, es: `${productFacts.supportedAppLanguages} idiomas: español, inglés, portugués, francés y alemán`, en: `${productFacts.supportedAppLanguages} languages: English, Spanish, Portuguese, French and German` },
  { icon: 'sliders' as const, es: 'Presets al empezar y un interruptor para cada herramienta', en: 'Presets on first launch and a switch for every tool' },
  { icon: 'device' as const, es: 'Widget de favoritos y atajos de la app', en: 'Favorites widget and app shortcuts' },
  { icon: 'refresh' as const, es: 'Papelera para recuperar lo que borras', en: 'A recycle bin to restore what you delete' },
];

const jump = [
  { href: '#calls', es: 'Llamadas y contactos', en: 'Calls and contacts' },
  { href: '#tools', es: 'Herramientas', en: 'Tools' },
  { href: '#style', es: 'Personalización', en: 'Personalization' },
  { href: '#more', es: 'Y más', en: 'And more' },
];
---

<Base
  title="Features — Fun Phone"
  description="Every Fun Phone feature: a T9 dialer, contacts and favorites, spam filtering, notes, an encrypted vault with autofill, expenses, QR, voice, calendar, Pomodoro, paint and 10 mini games."
  canonical="https://moncada25.github.io/fun-phone-web/features/"
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-editorial relative pb-16 pt-12 text-center md:pb-20 md:pt-20">
      <p class="eyebrow">
        <span x-cloak x-show="lang==='es'">Funciones</span>
        <span x-cloak x-show="lang==='en'">Features</span>
      </p>
      <h1 class="mx-auto mt-5 max-w-4xl text-balance font-display-condensed text-[2.75rem] font-extrabold leading-[0.95] tracking-tightest text-ink sm:text-[4rem] md:text-[5rem]">
        <span x-cloak x-show="lang==='es'">Todo lo que hace </span>
        <span x-cloak x-show="lang==='en'">Everything </span>
        <span class="font-serif-italic font-normal text-flame">Fun Phone</span>
        <span x-cloak x-show="lang==='en'"> does</span><span>.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-ink-muted">
        <span x-cloak x-show="lang==='es'">Un marcador completo y, si las quieres, diez herramientas más. Las capacidades de llamada dependen de tu dispositivo y de tu versión de Android.</span>
        <span x-cloak x-show="lang==='en'">A complete dialer and, if you want them, ten more tools. Calling capabilities depend on your device and Android version.</span>
      </p>
      <nav class="mt-9 flex flex-wrap justify-center gap-2" aria-label="Secciones" :aria-label="lang === 'es' ? 'Secciones' : 'Sections'">
        {jump.map((item) => (
          <a href={item.href} class="rounded-full border border-ink/15 bg-surface px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-ink/40">
            <span x-cloak x-show="lang==='es'">{item.es}</span>
            <span x-cloak x-show="lang==='en'">{item.en}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Calls and contacts -->
  <section id="calls" class="section scroll-mt-28 border-t border-ink/10">
    <div class="container-editorial">
      <div class="max-w-3xl">
        <p class="eyebrow">
          <span x-cloak x-show="lang==='es'">Llamadas y contactos</span>
          <span x-cloak x-show="lang==='en'">Calls and contacts</span>
        </p>
        <h2 class="section-title mt-4 text-ink">
          <span x-cloak x-show="lang==='es'">Lo primero, siempre.</span>
          <span x-cloak x-show="lang==='en'">Always first.</span>
        </h2>
      </div>

      <div class="mt-14 space-y-6">
        {coreFeatures.map((feature, i) => (
          <article class:list={['card reveal grid items-center gap-8 overflow-hidden p-7 md:gap-14 md:p-12', i % 2 === 1 ? 'md:grid-cols-[0.8fr_1.2fr]' : 'md:grid-cols-[1.2fr_0.8fr]']}>
            <div class:list={[i % 2 === 1 && 'md:order-2']}>
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-flame/10 text-flame">
                <Icon name={feature.icon} class="h-6 w-6" />
              </span>
              <h3 class="mt-6 font-display-condensed text-3xl font-extrabold tracking-tight text-ink md:text-4xl">
                <span x-cloak x-show="lang==='es'">{feature.title.es}</span>
                <span x-cloak x-show="lang==='en'">{feature.title.en}</span>
              </h3>
              <p class="mt-3 max-w-lg text-lg leading-relaxed text-ink-muted">
                <span x-cloak x-show="lang==='es'">{feature.desc.es}</span>
                <span x-cloak x-show="lang==='en'">{feature.desc.en}</span>
              </p>
              <ul class="mt-7 grid gap-3 sm:grid-cols-2">
                {coreDetails[feature.id].es.map((point, j) => (
                  <li class="flex items-start gap-2.5 text-[0.95rem] text-ink">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-flame" strokeWidth={2.4} />
                    <span>
                      <span x-cloak x-show="lang==='es'">{point}</span>
                      <span x-cloak x-show="lang==='en'">{coreDetails[feature.id].en[j]}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class:list={['mx-auto w-full max-w-[280px]', i % 2 === 1 && 'md:order-1']}>
              <div class="phone-frame">
                <LocalizedImage
                  src={`assets/store-v3/ui/{lang}/${feature.screen}.webp`}
                  alt={{ es: `Pantalla de ${feature.title.es} en Fun Phone`, en: `Fun Phone ${feature.title.en} screen` }}
                  width={720}
                  height={1607}
                />
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section id="tools" class="section scroll-mt-28 border-t border-ink/10 bg-surface/60">
    <div class="container-editorial">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="eyebrow">
            <span x-cloak x-show="lang==='es'">Herramientas opcionales</span>
            <span x-cloak x-show="lang==='en'">Optional tools</span>
          </p>
          <h2 class="section-title mt-4 text-ink">
            <span x-cloak x-show="lang==='es'">Diez herramientas. Tú decides cuáles.</span>
            <span x-cloak x-show="lang==='en'">Ten tools. You pick which.</span>
          </h2>
        </div>
        <p class="max-w-xl text-pretty text-lg leading-relaxed text-ink-muted lg:justify-self-end">
          <span x-cloak x-show="lang==='es'">Todas guardan sus datos en el teléfono. Actívalas durante la configuración o más tarde desde Ajustes.</span>
          <span x-cloak x-show="lang==='en'">All of them keep their data on your phone. Turn them on during setup or later in Settings.</span>
        </p>
      </div>

      <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {toolFeatures.map((tool) => (
          <article id={tool.id} class="card reveal flex scroll-mt-28 flex-col p-7">
            <div class="flex items-center gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-ink text-paper">
                <Icon name={tool.icon} class="h-5 w-5" />
              </span>
              <h3 class="font-display text-xl font-bold text-ink">
                <span x-cloak x-show="lang==='es'">{tool.title.es}</span>
                <span x-cloak x-show="lang==='en'">{tool.title.en}</span>
              </h3>
            </div>
            <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-muted">
              <span x-cloak x-show="lang==='es'">{tool.desc.es}</span>
              <span x-cloak x-show="lang==='en'">{tool.desc.en}</span>
            </p>
            <ul class="mt-5 space-y-2 border-t border-ink/10 pt-5">
              {toolDetails[tool.id].es.map((point, j) => (
                <li class="flex items-start gap-2.5 text-sm text-ink">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-flame" strokeWidth={2.4} />
                  <span>
                    <span x-cloak x-show="lang==='es'">{point}</span>
                    <span x-cloak x-show="lang==='en'">{toolDetails[tool.id].en[j]}</span>
                  </span>
                </li>
              ))}
            </ul>
          </article>
        ))}

        <article class="card reveal flex flex-col justify-between overflow-hidden p-7 md:col-span-2">
          <div class="grid items-center gap-6 sm:grid-cols-2">
            <div>
              <h3 class="font-display text-xl font-bold text-ink">
                <span x-cloak x-show="lang==='es'">Todas en un solo lugar</span>
                <span x-cloak x-show="lang==='en'">All in one place</span>
              </h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">
                <span x-cloak x-show="lang==='es'">El menú de herramientas reúne lo que activaste, sin instalar otra app para cada tarea.</span>
                <span x-cloak x-show="lang==='en'">The tools menu gathers what you turned on, without installing another app for each task.</span>
              </p>
            </div>
            <div class="mx-auto h-64 w-full max-w-[240px] overflow-hidden">
              <div class="phone-frame">
                <LocalizedImage
                  src="assets/store-v3/ui/{lang}/tools.webp"
                  alt={{ es: 'Menú de herramientas de Fun Phone', en: 'Fun Phone tools menu' }}
                  width={720}
                  height={1607}
                />
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Personalization -->
  <section id="style" class="section scroll-mt-28 border-t border-ink/10">
    <div class="container-editorial grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">
          <span x-cloak x-show="lang==='es'">Personalización y accesibilidad</span>
          <span x-cloak x-show="lang==='en'">Personalization and accessibility</span>
        </p>
        <h2 class="section-title mt-4 text-ink">
          <span x-cloak x-show="lang==='es'">{customization.title.es}.</span>
          <span x-cloak x-show="lang==='en'">{customization.title.en}.</span>
        </h2>
        <p class="mt-5 max-w-lg text-pretty text-lg leading-relaxed text-ink-muted">
          <span x-cloak x-show="lang==='es'">{customization.desc.es} Las vistas compactas y de texto grande se adaptan a cada pantalla.</span>
          <span x-cloak x-show="lang==='en'">{customization.desc.en} Compact and large-text layouts adapt to every screen.</span>
        </p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {customization.points?.es.map((point, i) => (
            <li class="card flex items-center gap-3 px-4 py-3.5 text-sm font-semibold text-ink">
              <Icon name="check" class="h-4 w-4 shrink-0 text-flame" strokeWidth={2.4} />
              <span>
                <span x-cloak x-show="lang==='es'">{point}</span>
                <span x-cloak x-show="lang==='en'">{customization.points?.en[i]}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div class="grid grid-cols-2 gap-4 sm:gap-6">
        <div class="phone-frame mt-10">
          <LocalizedImage
            src="assets/store-v3/ui/{lang}/settings.webp"
            alt={{ es: 'Ajustes de Fun Phone en modo claro', en: 'Fun Phone settings in light mode' }}
            width={720}
            height={1607}
          />
        </div>
        <div class="phone-frame">
          <LocalizedImage
            src="assets/store-v3/ui/{lang}/settings-dark.webp"
            alt={{ es: 'Ajustes de Fun Phone en modo oscuro', en: 'Fun Phone settings in dark mode' }}
            width={720}
            height={1607}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- More -->
  <section id="more" class="section scroll-mt-28 border-t border-ink/10 bg-surface/60">
    <div class="container-editorial">
      <p class="eyebrow">
        <span x-cloak x-show="lang==='es'">Y más</span>
        <span x-cloak x-show="lang==='en'">And more</span>
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {extras.map((extra) => (
          <div class="card flex items-start gap-4 p-6">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-flame/10 text-flame">
              <Icon name={extra.icon} class="h-5 w-5" />
            </span>
            <p class="text-[0.95rem] font-semibold leading-snug text-ink">
              <span x-cloak x-show="lang==='es'">{extra.es}</span>
              <span x-cloak x-show="lang==='en'">{extra.en}</span>
            </p>
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-3xl text-pretty leading-relaxed text-ink-muted">
        <span x-cloak x-show="lang==='es'">¿Te preocupa la privacidad? Revisa los permisos, las dos conexiones opcionales y cómo se guardan tus datos en la </span>
        <span x-cloak x-show="lang==='en'">Curious about privacy? See the permissions, the two optional connections and how your data is stored in the </span>
        <a href={base + 'privacy/'} class="font-semibold text-ink underline underline-offset-4 hover:text-flame">
          <span x-cloak x-show="lang==='es'">política de privacidad</span>
          <span x-cloak x-show="lang==='en'">privacy policy</span>
        </a>.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-editorial pt-20 md:pt-28">
    <div class="band-dark relative overflow-hidden rounded-[2rem] bg-ink px-7 py-14 text-paper md:px-14 md:py-16">
      <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-flame/30 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
        <h2 class="section-title">
          <span x-cloak x-show="lang==='es'">¿Listo para probarla?</span>
          <span x-cloak x-show="lang==='en'">Ready to try it?</span>
        </h2>
        <InstallButtons content="features_final_cta" inverted class="lg:justify-end" />
      </div>
    </div>
  </section>
</Base>
