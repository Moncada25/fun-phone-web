---
import Base from '../../layouts/Base.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import Icon from '../../components/Icon.astro';
import InstallButtons from '../../components/InstallButtons.astro';
import { allFaqs } from '../../data/faq';
import { discussionsUrl, issuesUrl, supportEmail } from '../../data/site';

const siteUrl = 'https://moncada25.github.io/fun-phone-web/faq/';

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q.en,
    acceptedAnswer: { '@type': 'Answer', text: faq.a.en },
  })),
});

const help = [
  { icon: 'code' as const, href: issuesUrl, external: true, title: { es: 'Reportar un error', en: 'Report a bug' }, desc: { es: 'Issues en GitHub', en: 'GitHub Issues' } },
  { icon: 'users' as const, href: discussionsUrl, external: true, title: { es: 'Proponer una idea', en: 'Suggest an idea' }, desc: { es: 'Discussions en GitHub', en: 'GitHub Discussions' } },
  { icon: 'note' as const, href: `mailto:${supportEmail}`, external: false, title: { es: 'Escribir al soporte', en: 'Email support' }, desc: { es: supportEmail, en: supportEmail } },
];
---

<Base
  title="FAQ — Fun Phone"
  description="Answers about Fun Phone: setup as default dialer, Google Play vs the GitHub APK, Obtainium updates, privacy, permissions, games and support."
  canonical={siteUrl}
>
  <script is:inline type="application/ld+json" slot="head" set:html={faqSchema}></script>

  <section class="relative overflow-hidden">
    <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-editorial relative pb-14 pt-12 text-center md:pb-16 md:pt-20">
      <p class="eyebrow">FAQ</p>
      <h1 class="mx-auto mt-5 max-w-4xl text-balance font-display-condensed text-[2.75rem] font-extrabold leading-[0.95] tracking-tightest text-ink sm:text-[4rem] md:text-[5rem]">
        <span x-cloak x-show="lang==='es'">Preguntas </span>
        <span x-cloak x-show="lang==='en'">Frequently asked </span>
        <span class="font-serif-italic font-normal text-flame">
          <span x-cloak x-show="lang==='es'">frecuentes</span>
          <span x-cloak x-show="lang==='en'">questions</span>
        </span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-ink-muted">
        <span x-cloak x-show="lang==='es'">Instalación, código abierto, privacidad y funciones. ¿No encuentras tu respuesta? Escríbenos.</span>
        <span x-cloak x-show="lang==='en'">Setup, open source, privacy and features. Can't find your answer? Get in touch.</span>
      </p>
    </div>
  </section>

  <section class="container-editorial pb-8">
    <div class="mx-auto max-w-3xl">
      <FAQBlock />
    </div>
  </section>

  <section class="section">
    <div class="container-editorial">
      <div class="mx-auto max-w-5xl">
        <h2 class="section-title text-center text-ink">
          <span x-cloak x-show="lang==='es'">¿Necesitas ayuda?</span>
          <span x-cloak x-show="lang==='en'">Need help?</span>
        </h2>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {help.map((item) => (
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener' : undefined}
              class="card group flex items-center gap-4 p-6 transition-colors hover:border-ink/30"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-flame/10 text-flame">
                <Icon name={item.icon} class="h-5 w-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-bold text-ink group-hover:text-flame">
                  <span x-cloak x-show="lang==='es'">{item.title.es}</span>
                  <span x-cloak x-show="lang==='en'">{item.title.en}</span>
                </span>
                <span class="block truncate text-sm text-ink-muted">
                  <span x-cloak x-show="lang==='es'">{item.desc.es}</span>
                  <span x-cloak x-show="lang==='en'">{item.desc.en}</span>
                </span>
              </span>
            </a>
          ))}
        </div>
        <div class="mt-14 flex justify-center">
          <InstallButtons content="faq_cta" />
        </div>
      </div>
    </div>
  </section>
</Base>
