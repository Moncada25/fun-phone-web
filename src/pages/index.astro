---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import InstallButtons from '../components/InstallButtons.astro';
import LocalizedImage from '../components/LocalizedImage.astro';
import ScreenshotCarousel from '../components/ScreenshotCarousel.astro';
import { playStoreUrl } from '../data/play-store';
import { coreFeatures, customization, toolFeatures } from '../data/features';
import { latestReleaseUrl, obtainiumUrl, productFacts, sourceRepoUrl } from '../data/site';

const base = import.meta.env.BASE_URL;
const socialImg = base + 'assets/store/en/feature-graphic.jpg';

const trust = [
  { es: 'Gratis', en: 'Free' },
  { es: productFacts.minimumAndroidLabel, en: productFacts.minimumAndroidLabel },
  { es: 'Sin anuncios ni analítica', en: 'No ads or analytics' },
  { es: `Código abierto ${productFacts.license}`, en: `Open source ${productFacts.license}` },
];

const facts = [
  { num: '0', label: { es: 'Anuncios, analítica o rastreadores', en: 'Ads, analytics or trackers' } },
  { num: '2', label: { es: 'Conexiones de red, ambas opcionales', en: 'Network connections, both optional' } },
  { num: String(productFacts.supportedAppLanguages), label: { es: 'Idiomas en la app', en: 'App languages' } },
  { num: String(productFacts.miniGames), label: { es: 'Minijuegos incluidos', en: 'Built-in mini games' } },
];

const privacyPoints = [
  {
    icon: 'device' as const,
    title: { es: 'Tus datos se quedan en el teléfono', en: 'Your data stays on your phone' },
    desc: {
      es: 'Contactos, llamadas, notas, contraseñas y gastos se guardan y procesan en tu dispositivo. El respaldo en la nube está desactivado.',
      en: 'Contacts, calls, notes, passwords and expenses are stored and processed on your device. Cloud backup is turned off.',
    },
  },
  {
    icon: 'eyeOff' as const,
    title: { es: 'Nada que te rastree', en: 'Nothing that tracks you' },
    desc: {
      es: 'Sin Firebase, anuncios, analítica, telemetría ni cuenta en la nube. El desarrollador no recibe tus datos.',
      en: 'No Firebase, ads, analytics, telemetry or cloud account. The developer never receives your data.',
    },
  },
  {
    icon: 'globe' as const,
    title: { es: 'Red solo cuando tú lo pides', en: 'Network only when you ask' },
    desc: {
      es: 'Solo dos funciones opcionales usan internet: los festivos (Nager.Date, tras tu aprobación) y la vista previa web o social que abres.',
      en: 'Only two optional features go online: public holidays (Nager.Date, after your approval) and the web or social preview you open.',
    },
  },
];

const installOptions = [
  {
    icon: 'play' as const,
    title: { es: 'Google Play', en: 'Google Play' },
    tag: { es: 'Recomendado', en: 'Recommended' },
    desc: {
      es: 'La forma más sencilla: instalación en un toque y actualizaciones automáticas.',
      en: 'The easiest way: one-tap install and automatic updates.',
    },
    href: playStoreUrl('home_install_options'),
    cta: { es: 'Abrir Google Play', en: 'Open Google Play' },
  },
  {
    icon: 'github' as const,
    title: { es: 'APK en GitHub', en: 'APK on GitHub' },
    tag: { es: 'Sin Google', en: 'Google-free' },
    desc: {
      es: 'Cada versión publica un APK firmado de la edición community, compilado sin librerías de Google.',
      en: 'Every release ships a signed community APK, built without Google libraries.',
    },
    href: latestReleaseUrl,
    cta: { es: 'Ver la última versión', en: 'See the latest release' },
  },
  {
    icon: 'refresh' as const,
    title: { es: 'Obtainium', en: 'Obtainium' },
    tag: { es: 'Actualizaciones', en: 'Updates' },
    desc: {
      es: 'Añade la URL del repositorio en Obtainium y recibe cada nueva versión de GitHub automáticamente.',
      en: 'Add the repository URL to Obtainium and get every new GitHub release automatically.',
    },
    href: obtainiumUrl,
    cta: { es: 'Conocer Obtainium', en: 'Get Obtainium' },
  },
];

const videos = [
  { lang: 'es', label: 'Video de Fun Phone: recorrido de 38 segundos por la app' },
  { lang: 'en', label: 'Fun Phone video: a 38-second tour of the app' },
];

const videoFormats = [
  { file: 'promo-vertical', width: 720, height: 1280, aspect: 'aspect-[9/16]', wrapper: 'mx-auto max-w-[360px] md:hidden' },
  { file: 'promo', width: 1280, height: 720, aspect: 'aspect-video', wrapper: 'hidden md:block' },
];

const faqTeaser = [
  {
    q: { es: '¿Puede reemplazar mi app de teléfono?', en: 'Can it replace my phone app?' },
    a: {
      es: 'Sí. Tras instalarla, abre Estado del dispositivo en la app para conceder permisos y elegir Fun Phone como marcador predeterminado.',
      en: 'Yes. After installing, open Device Status in the app to grant permissions and choose Fun Phone as your default dialer.',
    },
  },
  {
    q: { es: '¿Es gratis? ¿Tiene anuncios?', en: 'Is it free? Does it have ads?' },
    a: {
      es: 'Es gratis, sin anuncios, sin micropagos y sin SDKs de analítica.',
      en: 'It is free, with no ads, no in-app purchases and no analytics SDKs.',
    },
  },
  {
    q: { es: '¿Play o GitHub?', en: 'Play or GitHub?' },
    a: {
      es: 'Ofrecen las mismas funciones. Play se actualiza solo; el APK de GitHub no lleva librerías de Google. Pueden convivir, pero no comparten datos.',
      en: 'They offer the same features. Play updates itself; the GitHub APK has no Google libraries. They can live side by side but do not share data.',
    },
  },
];
---

<Base
  preloadSerifFont
  title="Fun Phone — Private, open-source Android dialer and contacts"
  description="Fun Phone is a private, open-source Android dialer and contacts app with T9 search, an encrypted vault, notes, expenses and games. No ads or analytics. Get it on Google Play or GitHub."
  ogImage={socialImg}
  canonical="https://moncada25.github.io/fun-phone-web/"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "name": "Fun Phone: Dialer & Contacts",
    "operatingSystem": "Android 10+",
    "applicationCategory": "CommunicationApplication",
    "inLanguage": ["es", "en", "pt", "fr", "de"],
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "downloadUrl": "https://play.google.com/store/apps/details?id=com.bookverse.contacts",
    "license": "https://www.gnu.org/licenses/gpl-3.0.html",
    "isAccessibleForFree": true,
    "codeRepository": sourceRepoUrl,
    "sameAs": [sourceRepoUrl],
    "author": { "@type": "Organization", "name": "Bookverse" },
    "privacyPolicy": "https://moncada25.github.io/fun-phone-web/privacy/"
  })}></script>

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-editorial relative grid items-center gap-14 pb-20 pt-10 md:pt-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-10 lg:pb-28">
      <div>
        <a href={sourceRepoUrl} target="_blank" rel="noopener" class="group inline-flex items-center gap-2 rounded-full border border-ink/15 bg-surface py-1.5 pl-1.5 pr-3.5 text-[0.8rem] font-semibold text-ink transition-colors hover:border-ink/40">
          <span class="rounded-full bg-flame px-2 py-0.5 font-mono text-[0.62rem] font-bold uppercase tracking-[0.12em] text-paper">
            <span x-cloak x-show="lang==='es'">Nuevo</span><span x-cloak x-show="lang==='en'">New</span>
          </span>
          <span x-cloak x-show="lang==='es'">Ahora es código abierto</span>
          <span x-cloak x-show="lang==='en'">Now open source</span>
          <Icon name="arrow" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>

        <h1 class="mt-7 text-balance font-display-condensed text-[2.9rem] font-extrabold leading-[0.95] tracking-tightest text-ink sm:text-[4rem] lg:text-[4.75rem] xl:text-[5.5rem]">
          <span x-cloak x-show="lang==='es'">El marcador privado </span>
          <span x-cloak x-show="lang==='en'">The private dialer </span>
          <span class="font-serif-italic font-normal text-flame">
            <span x-cloak x-show="lang==='es'">que hace más.</span>
            <span x-cloak x-show="lang==='en'">that does more.</span>
          </span>
        </h1>

        <p class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-ink-muted md:text-xl">
          <span x-cloak x-show="lang==='es'">Llamadas y contactos primero. Cuando quieras más, activa notas, una bóveda cifrada, gastos, QR y juegos. Sin anuncios, sin analítica y con el código a la vista.</span>
          <span x-cloak x-show="lang==='en'">Calls and contacts come first. When you want more, turn on notes, an encrypted vault, expenses, QR tools and games. No ads, no analytics, and the code is out in the open.</span>
        </p>

        <InstallButtons content="home_hero" class="mt-9" />

        <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-ink-muted">
          {trust.map((item) => (
            <li class="inline-flex items-center gap-1.5">
              <Icon name="check" class="h-4 w-4 text-flame" strokeWidth={2.4} />
              <span x-cloak x-show="lang==='es'">{item.es}</span>
              <span x-cloak x-show="lang==='en'">{item.en}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="relative mx-auto w-full max-w-[420px] lg:max-w-[460px]">
        <div class="absolute -right-4 top-10 hidden w-[62%] rotate-6 opacity-90 sm:block lg:-right-10" aria-hidden="true">
          <div class="phone-frame">
            <LocalizedImage src="assets/store/ui/{lang}/favorites.webp" alt={{ es: '', en: '' }} width={720} height={1607} fetchpriority="low" />
          </div>
        </div>
        <div class="phone-frame relative mx-auto w-[78%] sm:mx-0 sm:-rotate-2">
          <LocalizedImage
            src="assets/store/ui/{lang}/dialer.webp"
            alt={{ es: 'Marcador de Fun Phone con búsqueda T9 y prefijo del país', en: 'Fun Phone dialer with T9 search and the country code' }}
            width={720}
            height={1607}
            fetchpriority="low"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FACTS -->
  <section class="border-y border-ink/10 bg-surface">
    <div class="container-editorial grid grid-cols-2 divide-ink/10 md:grid-cols-4 md:divide-x">
      {facts.map((fact) => (
        <div class="px-2 py-8 md:px-8 md:py-10">
          <p class="font-display-condensed text-5xl font-extrabold leading-none tracking-tighter text-ink md:text-6xl">{fact.num}</p>
          <p class="mt-2 text-sm font-medium text-ink-muted">
            <span x-cloak x-show="lang==='es'">{fact.label.es}</span>
            <span x-cloak x-show="lang==='en'">{fact.label.en}</span>
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- VIDEO -->
  <section class="section" id="video">
    <div class="container-editorial">
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
        <div>
          <p class="eyebrow">
            <span x-cloak x-show="lang==='es'">En video</span>
            <span x-cloak x-show="lang==='en'">Video</span>
          </p>
          <h2 class="section-title mt-4 text-ink">
            <span x-cloak x-show="lang==='es'">Fun Phone en 38 segundos.</span>
            <span x-cloak x-show="lang==='en'">Fun Phone in 38 seconds.</span>
          </h2>
        </div>
        <p class="max-w-xl text-pretty text-lg leading-relaxed text-ink-muted lg:justify-self-end">
          <span x-cloak x-show="lang==='es'">Un recorrido por el marcador, las llamadas, los contactos, las notas, la bóveda, los gastos y los estilos. Todo con datos de ejemplo.</span>
          <span x-cloak x-show="lang==='en'">A quick tour of the dialer, calls, contacts, notes, vault, expenses and styles, all with demo data.</span>
        </p>
      </div>

      {videoFormats.map((format) => (
        <div class:list={['reveal mt-12 overflow-hidden rounded-[2rem] border border-ink/10 bg-[#F4F2EE] shadow-[0_40px_80px_-40px_rgba(10,10,14,0.45)]', format.wrapper]}>
          {videos.map((video) => (
            <video
              class={`block h-auto w-full ${format.aspect}`}
              width={format.width}
              height={format.height}
              controls
              playsinline
              preload="none"
              poster={base + `assets/video/${format.file}-${video.lang}.webp`}
              aria-label={video.label}
              x-cloak
              x-show={`lang==='${video.lang}'`}
              x-effect={`if (lang !== '${video.lang}') $el.pause()`}
            >
              <source src={base + `assets/video/${format.file}-${video.lang}.mp4`} type="video/mp4" />
            </video>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- CORE -->
  <section class="section" id="core">
    <div class="container-editorial">
      <div class="max-w-3xl">
        <p class="eyebrow">
          <span x-cloak x-show="lang==='es'">Lo esencial</span>
          <span x-cloak x-show="lang==='en'">The essentials</span>
        </p>
        <h2 class="section-title mt-4 text-ink">
          <span x-cloak x-show="lang==='es'">Un marcador completo que puede reemplazar al de tu teléfono.</span>
          <span x-cloak x-show="lang==='en'">A complete dialer that can replace the one on your phone.</span>
        </h2>
      </div>

      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {coreFeatures.map((feature) => (
          <article class="card reveal flex flex-col overflow-hidden">
            <div class="p-7 pb-0">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-flame/10 text-flame">
                <Icon name={feature.icon} class="h-5 w-5" />
              </span>
              <h3 class="mt-5 font-display-condensed text-2xl font-extrabold tracking-tight text-ink">
                <span x-cloak x-show="lang==='es'">{feature.title.es}</span>
                <span x-cloak x-show="lang==='en'">{feature.title.en}</span>
              </h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-muted">
                <span x-cloak x-show="lang==='es'">{feature.desc.es}</span>
                <span x-cloak x-show="lang==='en'">{feature.desc.en}</span>
              </p>
              <ul class="mt-5 space-y-2 text-sm text-ink">
                {feature.points?.es.map((point, i) => (
                  <li class="flex items-start gap-2">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-flame" strokeWidth={2.4} />
                    <span>
                      <span x-cloak x-show="lang==='es'">{point}</span>
                      <span x-cloak x-show="lang==='en'">{feature.points?.en[i]}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="relative mt-8 h-72 overflow-hidden px-10 md:h-80">
              <div class="phone-frame mx-auto max-w-[260px] rounded-b-none pb-0">
                <LocalizedImage
                  src={`assets/store/ui/{lang}/${feature.screen}.webp`}
                  alt={{ es: `Pantalla de ${feature.title.es} en Fun Phone`, en: `Fun Phone ${feature.title.en} screen` }}
                  width={720}
                  height={1607}
                  class="rounded-b-none"
                />
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="section border-t border-ink/10 bg-surface/60" id="tools">
    <div class="container-editorial">
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
        <div>
          <p class="eyebrow">
            <span x-cloak x-show="lang==='es'">Herramientas opcionales</span>
            <span x-cloak x-show="lang==='en'">Optional tools</span>
          </p>
          <h2 class="section-title mt-4 text-ink">
            <span x-cloak x-show="lang==='es'">Todo lo demás, solo si lo activas.</span>
            <span x-cloak x-show="lang==='en'">Everything else, only if you turn it on.</span>
          </h2>
        </div>
        <p class="max-w-xl text-pretty text-lg leading-relaxed text-ink-muted lg:justify-self-end">
          <span x-cloak x-show="lang==='es'">Elige un preset al empezar o enciende cada herramienta por separado. Lo que no uses no aparece, y el marcador sigue siendo lo primero.</span>
          <span x-cloak x-show="lang==='en'">Pick a preset when you start or switch each tool on by itself. What you don't use stays out of sight, and the dialer always comes first.</span>
        </p>
      </div>

      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {toolFeatures.map((tool) => (
          <article class="card reveal flex items-start gap-4 p-5 transition-colors hover:border-ink/30 sm:flex-col sm:gap-3 sm:p-6">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-ink text-paper">
              <Icon name={tool.icon} class="h-[1.15rem] w-[1.15rem]" />
            </span>
            <div>
            <h3 class="font-display text-lg font-bold leading-tight text-ink sm:mt-1">
              <span x-cloak x-show="lang==='es'">{tool.title.es}</span>
              <span x-cloak x-show="lang==='en'">{tool.title.en}</span>
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-muted sm:mt-3">
              <span x-cloak x-show="lang==='es'">{tool.desc.es}</span>
              <span x-cloak x-show="lang==='en'">{tool.desc.en}</span>
            </p>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-10">
        <a href={base + 'features/'} class="group inline-flex items-center gap-2 font-semibold text-ink underline-offset-4 hover:text-flame hover:underline">
          <span x-cloak x-show="lang==='es'">Ver todas las funciones</span>
          <span x-cloak x-show="lang==='en'">See every feature</span>
          <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- CUSTOMIZATION -->
  <section class="section" id="style">
    <div class="container-editorial grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="order-2 lg:order-1">
        <div class="mx-auto max-w-[400px] overflow-hidden rounded-[2rem] border border-ink/10 shadow-[0_40px_80px_-40px_rgba(10,10,14,0.45)]">
          <LocalizedImage
            src="assets/store/{lang}/08-styles.webp"
            alt={{ es: 'Tres estilos de Fun Phone: Moderno, Minimalista y Retro', en: 'Three Fun Phone styles: Modern, Minimalist and Retro' }}
            width={1080}
            height={1920}
            class="block h-auto w-full"
          />
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <p class="eyebrow">
          <span x-cloak x-show="lang==='es'">Personalización</span>
          <span x-cloak x-show="lang==='en'">Personalization</span>
        </p>
        <h2 class="section-title mt-4 text-ink">
          <span x-cloak x-show="lang==='es'">{customization.title.es}.</span>
          <span x-cloak x-show="lang==='en'">{customization.title.en}.</span>
        </h2>
        <p class="mt-5 max-w-lg text-pretty text-lg leading-relaxed text-ink-muted">
          <span x-cloak x-show="lang==='es'">{customization.desc.es}</span>
          <span x-cloak x-show="lang==='en'">{customization.desc.en}</span>
        </p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {customization.points?.es.map((point, i) => (
            <li class="card flex items-center gap-3 px-4 py-3.5 text-sm font-semibold text-ink">
              <Icon name="check" class="h-4 w-4 shrink-0 text-flame" strokeWidth={2.4} />
              <span>
                <span x-cloak x-show="lang==='es'">{point}</span>
                <span x-cloak x-show="lang==='en'">{customization.points?.en[i]}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section border-t border-ink/10" id="gallery">
    <div class="container-editorial">
      <ScreenshotCarousel />
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="section band-dark bg-ink text-paper" id="privacy">
    <div class="container-editorial">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="eyebrow">
            <span x-cloak x-show="lang==='es'">Privacidad</span>
            <span x-cloak x-show="lang==='en'">Privacy</span>
          </p>
          <h2 class="section-title mt-4">
            <span x-cloak x-show="lang==='es'">Privada por diseño, no por promesa.</span>
            <span x-cloak x-show="lang==='en'">Private by design, not by promise.</span>
          </h2>
        </div>
        <p class="max-w-xl text-pretty text-lg leading-relaxed text-paper/70 lg:justify-self-end">
          <span x-cloak x-show="lang==='es'">El código es público, así que puedes comprobar qué hace cada permiso y cada conexión.</span>
          <span x-cloak x-show="lang==='en'">The code is public, so you can check what every permission and every connection does.</span>
        </p>
      </div>
      <div class="mt-14 grid gap-4 md:grid-cols-3">
        {privacyPoints.map((point) => (
          <article class="reveal rounded-3xl border border-paper/15 p-7">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-paper/10 text-flame">
              <Icon name={point.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-5 font-display text-xl font-bold leading-snug">
              <span x-cloak x-show="lang==='es'">{point.title.es}</span>
              <span x-cloak x-show="lang==='en'">{point.title.en}</span>
            </h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-paper/70">
              <span x-cloak x-show="lang==='es'">{point.desc.es}</span>
              <span x-cloak x-show="lang==='en'">{point.desc.en}</span>
            </p>
          </article>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm font-semibold">
        <a href={base + 'privacy/'} class="group inline-flex items-center gap-2 text-paper hover:text-flame">
          <span x-cloak x-show="lang==='es'">Leer la política de privacidad</span>
          <span x-cloak x-show="lang==='en'">Read the privacy policy</span>
          <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a href={sourceRepoUrl} target="_blank" rel="noopener" class="group inline-flex items-center gap-2 text-paper hover:text-flame">
          <span x-cloak x-show="lang==='es'">Revisar el código</span>
          <span x-cloak x-show="lang==='en'">Review the code</span>
          <Icon name="external" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- OPEN SOURCE / INSTALL OPTIONS -->
  <section class="section" id="install">
    <div class="container-editorial">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">
          <span x-cloak x-show="lang==='es'">Código abierto · {productFacts.license}</span>
          <span x-cloak x-show="lang==='en'">Open source · {productFacts.license}</span>
        </p>
        <h2 class="section-title mt-4 text-ink">
          <span x-cloak x-show="lang==='es'">Instálala como prefieras.</span>
          <span x-cloak x-show="lang==='en'">Install it your way.</span>
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-pretty text-lg leading-relaxed text-ink-muted">
          <span x-cloak x-show="lang==='es'">Fun Phone es software libre. Descárgala de Google Play o instala el APK de GitHub y mantenlo al día con Obtainium.</span>
          <span x-cloak x-show="lang==='en'">Fun Phone is free software. Get it from Google Play, or install the GitHub APK and keep it up to date with Obtainium.</span>
        </p>
      </div>

      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {installOptions.map((option, i) => (
          <a
            href={option.href}
            target="_blank"
            rel="noopener"
            class:list={['card group reveal flex flex-col p-7 transition-all hover:-translate-y-1 hover:border-ink/40', i === 0 && 'ring-2 ring-flame/60']}
          >
            <div class="flex items-center justify-between">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-ink text-paper">
                <Icon name={option.icon} class="h-6 w-6" />
              </span>
              <span class:list={['rounded-full px-2.5 py-1 font-mono text-[0.62rem] font-bold uppercase tracking-[0.12em]', i === 0 ? 'bg-flame text-paper' : 'bg-ink/5 text-ink-muted']}>
                <span x-cloak x-show="lang==='es'">{option.tag.es}</span>
                <span x-cloak x-show="lang==='en'">{option.tag.en}</span>
              </span>
            </div>
            <h3 class="mt-6 font-display-condensed text-2xl font-extrabold tracking-tight text-ink">
              <span x-cloak x-show="lang==='es'">{option.title.es}</span>
              <span x-cloak x-show="lang==='en'">{option.title.en}</span>
            </h3>
            <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-ink-muted">
              <span x-cloak x-show="lang==='es'">{option.desc.es}</span>
              <span x-cloak x-show="lang==='en'">{option.desc.en}</span>
            </p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-ink group-hover:text-flame">
              <span x-cloak x-show="lang==='es'">{option.cta.es}</span>
              <span x-cloak x-show="lang==='en'">{option.cta.en}</span>
              <Icon name="external" class="h-4 w-4" />
            </span>
          </a>
        ))}
      </div>

      <div class="card mt-5 flex flex-col items-start gap-5 p-7 md:flex-row md:items-center md:justify-between">
        <div class="flex items-start gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-flame/10 text-flame">
            <Icon name="code" class="h-6 w-6" />
          </span>
          <div>
            <h3 class="font-display text-lg font-bold text-ink">
              <span x-cloak x-show="lang==='es'">¿Quieres ayudar?</span>
              <span x-cloak x-show="lang==='en'">Want to help?</span>
            </h3>
            <p class="mt-1 max-w-2xl text-[0.95rem] leading-relaxed text-ink-muted">
              <span x-cloak x-show="lang==='es'">Reporta errores, propone ideas o envía un pull request. Kotlin, Jetpack Compose y Material 3.</span>
              <span x-cloak x-show="lang==='en'">Report bugs, suggest ideas or send a pull request. Kotlin, Jetpack Compose and Material 3.</span>
            </p>
          </div>
        </div>
        <a href={sourceRepoUrl} target="_blank" rel="noopener" class="btn-outline shrink-0">
          <Icon name="github" class="h-5 w-5" />
          <span class="font-bold">
            <span x-cloak x-show="lang==='es'">Ver en GitHub</span>
            <span x-cloak x-show="lang==='en'">View on GitHub</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ TEASER -->
  <section class="section border-t border-ink/10 bg-surface/60" id="faq">
    <div class="container-editorial grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title mt-4 text-ink">
          <span x-cloak x-show="lang==='es'">Preguntas rápidas.</span>
          <span x-cloak x-show="lang==='en'">Quick answers.</span>
        </h2>
        <a href={base + 'faq/'} class="group mt-8 inline-flex items-center gap-2 font-semibold text-ink hover:text-flame">
          <span x-cloak x-show="lang==='es'">Todas las preguntas</span>
          <span x-cloak x-show="lang==='en'">All questions</span>
          <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
      <div class="divide-y divide-ink/10 border-y border-ink/10">
        {faqTeaser.map((item) => (
          <div class="py-6">
            <h3 class="font-display text-lg font-bold text-ink">
              <span x-cloak x-show="lang==='es'">{item.q.es}</span>
              <span x-cloak x-show="lang==='en'">{item.q.en}</span>
            </h3>
            <p class="mt-2 leading-relaxed text-ink-muted">
              <span x-cloak x-show="lang==='es'">{item.a.es}</span>
              <span x-cloak x-show="lang==='en'">{item.a.en}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="container-editorial pb-6 pt-20 md:pt-28">
    <div class="band-dark relative overflow-hidden rounded-[2rem] bg-ink px-7 py-14 text-paper md:px-14 md:py-20">
      <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-flame/30 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-end">
        <div>
          <h2 class="section-title">
            <span x-cloak x-show="lang==='es'">Prueba Fun Phone hoy.</span>
            <span x-cloak x-show="lang==='en'">Try Fun Phone today.</span>
          </h2>
          <p class="mt-5 max-w-xl text-pretty text-lg leading-relaxed text-paper/70">
            <span x-cloak x-show="lang==='es'">Gratis, sin anuncios y en cinco idiomas: español, inglés, portugués, francés y alemán. Para {productFacts.minimumAndroidLabel}.</span>
            <span x-cloak x-show="lang==='en'">Free, ad-free and in five languages: English, Spanish, Portuguese, French and German. For {productFacts.minimumAndroidLabel}.</span>
          </p>
        </div>
        <InstallButtons content="home_final_cta" inverted class="lg:justify-end" />
      </div>
    </div>
  </section>
</Base>
