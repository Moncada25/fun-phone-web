---
import Base from '../../layouts/Base.astro';
import PermissionsBlock from '../../components/PermissionsBlock.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';

const lastUpdated = { es: '17 ago 2026', en: 'August 17, 2026' };
const rows = [
  { es: 'Contactos, favoritos e historial', en: 'Contacts, favorites, and call history', controlEs: 'Se procesan en el dispositivo mediante los proveedores protegidos y permisos de Android.', controlEn: 'Processed on-device through Android protected providers and permissions.' },
  { es: 'Notas, contraseñas y ajustes', en: 'Notes, passwords, and settings', controlEs: 'Se guardan localmente; secretos y bases sensibles se excluyen del backup y usan Android Keystore/Tink.', controlEn: 'Stored locally; secrets and sensitive databases are excluded from backup and use Android Keystore/Tink.' },
  { es: 'Fotos y exportaciones', en: 'Photos and exports', controlEs: 'Se comparten como archivos content:// solo con la app elegida en Android Sharesheet.', controlEn: 'Shared as local content:// files only with the app selected in Android Sharesheet.' },
  { es: 'Festivos públicos', en: 'Public holidays', controlEs: 'Tras un aviso y tu autorización, se envían país y año a date.nager.at por HTTPS; el servicio recibe IP y metadata técnica.', controlEn: 'After a disclosure and your approval, country and year are sent to date.nager.at over HTTPS; the service receives IP and technical metadata.' },
  { es: 'Voz, enlaces y reseñas', en: 'Speech, links, and reviews', controlEs: 'Android entrega la acción al proveedor de voz, app externa o Google Play; Fun Phone no recibe audio ni contenido de reseñas.', controlEn: 'Android hands the action to the speech provider, external app, or Google Play; Fun Phone receives no audio or review content.' },
];
---

<Base
  title="Privacy Policy — Fun Phone"
  description="Fun Phone is local-first, contains no ads or analytics, and uses the network only for an optional disclosed public-holidays lookup."
  canonical="https://moncada25.github.io/fun-phone-web/privacy/"
>
  <section class="border-b border-ink/15">
    <div class="container-editorial py-20 text-center md:py-28">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-flame">Privacy by architecture</p>
      <h1 class="mt-5 font-display-condensed text-6xl font-extrabold tracking-tightest md:text-8xl">
        <span x-cloak x-show="lang==='es'">Tus datos permanecen </span>
        <span x-cloak x-show="lang==='en'">Your data stays </span>
        <span class="font-serif-italic text-flame">
          <span x-cloak x-show="lang==='es'">contigo.</span>
          <span x-cloak x-show="lang==='en'">with you.</span>
        </span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">
        <span x-cloak x-show="lang==='es'">Fun Phone no contiene Firebase, publicidad, analítica, telemetría, autenticación remota ni nube del desarrollador. La consulta opcional de festivos es su única conexión directa.</span>
        <span x-cloak x-show="lang==='en'">Fun Phone contains no Firebase, ads, analytics, telemetry, remote authentication, or developer cloud. The optional holidays lookup is its only direct connection.</span>
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <PrivacyBadge />
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-ink-ghost">
          <span x-cloak x-show="lang==='es'">Actualizado: {lastUpdated.es}</span>
          <span x-cloak x-show="lang==='en'">Updated: {lastUpdated.en}</span>
        </span>
      </div>
    </div>
  </section>

  <section class="container-editorial py-16 md:py-24">
    <div class="mx-auto max-w-4xl">
      <div class="grid gap-4 md:grid-cols-3">
        <article class="rounded-2xl border border-ink/15 p-6"><p class="font-display-condensed text-5xl font-extrabold text-flame">0</p><p class="mt-2 font-semibold"><span x-cloak x-show="lang==='es'">Datos recopilados por el desarrollador</span><span x-cloak x-show="lang==='en'">Data collected by the developer</span></p></article>
        <article class="rounded-2xl border border-ink/15 p-6"><p class="font-display-condensed text-5xl font-extrabold">0</p><p class="mt-2 font-semibold"><span x-cloak x-show="lang==='es'">SDKs de anuncios o analítica</span><span x-cloak x-show="lang==='en'">Ads or analytics SDKs</span></p></article>
        <article class="rounded-2xl border border-ink/15 p-6"><p class="font-display-condensed text-5xl font-extrabold">1</p><p class="mt-2 font-semibold"><span x-cloak x-show="lang==='es'">Flujo de red directo y opcional</span><span x-cloak x-show="lang==='en'">Optional direct network flow</span></p></article>
      </div>

      <h2 class="mt-16 font-display-condensed text-4xl font-extrabold"><span x-cloak x-show="lang==='es'">Cómo funciona cada flujo</span><span x-cloak x-show="lang==='en'">How each flow works</span></h2>
      <div class="mt-7 divide-y divide-ink/10 border-y border-ink/15">
        {rows.map((row) => (
          <article class="grid gap-2 py-6 md:grid-cols-[.8fr_1.2fr] md:gap-8">
            <h3 class="font-bold"><span x-cloak x-show="lang==='es'">{row.es}</span><span x-cloak x-show="lang==='en'">{row.en}</span></h3>
            <p class="text-ink-muted"><span x-cloak x-show="lang==='es'">{row.controlEs}</span><span x-cloak x-show="lang==='en'">{row.controlEn}</span></p>
          </article>
        ))}
      </div>

      <h2 class="mt-16 font-display-condensed text-4xl font-extrabold"><span x-cloak x-show="lang==='es'">Permisos bajo tu control</span><span x-cloak x-show="lang==='en'">Permissions under your control</span></h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-muted">
        <span x-cloak x-show="lang==='es'">Los permisos de llamadas y contactos respaldan el rol de teléfono. Cámara, micrófono y calendario se usan solo al activar sus herramientas. Internet y estado de red son permisos normales de Android reservados para la consulta de festivos.</span>
        <span x-cloak x-show="lang==='en'">Call and contact permissions support the phone role. Camera, microphone, and calendar are used only when their tools are enabled. Internet and network state are normal Android permissions reserved for the holidays lookup.</span>
      </p>
      <div class="mt-7"><PermissionsBlock /></div>

      <div class="mt-14 rounded-3xl bg-ink p-8 text-paper md:p-10">
        <h2 class="font-display-condensed text-4xl font-extrabold"><span x-cloak x-show="lang==='es'">Tus controles</span><span x-cloak x-show="lang==='en'">Your controls</span></h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-paper/75"><span x-cloak x-show="lang==='es'">Puedes rechazar la conexión de festivos, revocar permisos, borrar contenido, limpiar los datos de la app o desinstalarla. El desarrollador no conserva un registro remoto que deba eliminar.</span><span x-cloak x-show="lang==='en'">You can decline the holidays connection, revoke permissions, delete content, clear app data, or uninstall. The developer keeps no remote user record that needs deletion.</span></p>
      </div>
    </div>
  </section>
</Base>
