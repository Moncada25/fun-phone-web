---
import '../styles/global.css';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  bodyClass?: string;
  noSticky?: boolean;
  noChrome?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  bodyClass = '',
  noSticky = false,
  noChrome = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ?? new URL('https://moncada25.github.io');
const canonicalUrl = canonical ? new URL(canonical, siteUrl).href : new URL(Astro.url.pathname, siteUrl).href;
const heroImg = new URL(
  ogImage || (base + 'assets/store-v2/en/feature-graphic.jpg'),
  siteUrl,
).href;
---

<!DOCTYPE html>
<html
  lang="es"
  data-lang="es"
  x-data="{ lang: document.documentElement.dataset.lang || 'es' }"
  x-bind:lang="lang"
  @lang.window="lang = $event.detail"
  class="scroll-smooth"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#F3F3F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090B" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="manifest" href={base + 'site.webmanifest'} />
    <link rel="icon" type="image/png" href={base + 'assets/logo.png'} />
    <link rel="apple-touch-icon" href={base + 'assets/logo.png'} />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fun Phone" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={heroImg} />
    <meta property="og:image:alt" content="Fun Phone Android dialer and contacts app" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImg} />
    <meta name="twitter:image:alt" content="Fun Phone Android dialer and contacts app" />

    <!-- Set theme class before paint -->
    <script is:inline>
      (function () {
        const read = (name) => { try { return localStorage.getItem(name); } catch (_) { return null; } };
        const write = (name, value) => { try { localStorage.setItem(name, value); } catch (_) { /* optional preference */ } };
        window.funPhonePreferences = { read, write };
        const saved = read('darkMode');
        const isDark = saved !== null ? saved === 'true' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        const savedLang = read('lang');
        const lang = ['es', 'en'].includes(savedLang) ? savedLang : (navigator.language?.startsWith('es') ? 'es' : 'en');
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
      })();
    </script>

    <script>
      import Alpine from 'alpinejs';

      Alpine.start();
    </script>

    <slot name="head" />
  </head>

  <body class:list={["bg-paper text-ink antialiased selection:bg-flame selection:text-paper", bodyClass]}>
    {!noChrome && <Navbar />}

    <main id="main-content" class={noChrome ? '' : 'pt-[88px]'}>
      <slot />
    </main>

    {!noChrome && <Footer />}
    {!noChrome && !noSticky && <StickyCTA />}

    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const register = () => navigator.serviceWorker.register(`${base}service-worker.js`, { scope: base }).catch(() => { /* available on the next online visit */ });
          if ('requestIdleCallback' in window) window.requestIdleCallback(register, { timeout: 5000 });
          else setTimeout(register, 500);
        });
      }
    </script>

    <script is:inline>
      // Reveal-on-scroll observer (lightweight, no deps)
      (function () {
        if (typeof window === 'undefined') return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
          return;
        }
        const io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) {
          if (el.getBoundingClientRect().top >= window.innerHeight) el.classList.add('reveal-pending');
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
