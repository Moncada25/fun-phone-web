{
  "name": "fun-phone-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "check:discovery": "node scripts/check-discovery.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
